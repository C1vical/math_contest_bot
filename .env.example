# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---- Discord -------------------------------------------------------------
DISCORD_TOKEN=
# Restrict commands to these channels / roles (comma-separated IDs). Empty = no restriction.
ALLOWED_CHANNEL_IDS=
ALLOWED_ROLE_IDS=
# Admins for /admin commands. If both are empty, members with "Manage Server" are admins.
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
# Sync slash commands to one guild (appears instantly). Empty = global sync (can take up to an hour).
GUILD_ID=
SYNC_COMMANDS=true
# Post "bot is online" once per start in this channel. Empty = no announcement.
ANNOUNCE_CHANNEL_ID=

# Seconds between /problem, /gimme, /random per user (admins exempt). 0 disables.
COMMAND_COOLDOWN_SECONDS=3

# ---- Health endpoint -----------------------------------------------------
HEALTH_ENABLED=true
PORT=8080

# ---- Paths (relative paths are resolved from the project root) -----------
DATA_DIR=data
# DATABASE_PATH=data/problems.db
# RENDERS_DIR=data/renders

# ---- Contests ------------------------------------------------------------
# Optional contests are off by default. Enable only after validating the source, e.g. CJMO,CMOQR,GAUSS7,GAUSS8
ENABLE_CONTESTS=
DISABLE_CONTESTS=

# ---- Scraping ------------------------------------------------------------
# Identify yourself honestly; include a contact URL or email so site owners can reach you.
HTTP_USER_AGENT=math-contest-bot/2.0 (+https://example.com/contact)
HTTP_MIN_INTERVAL=1.0
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=4
HTTP_CACHE_TTL=86400
INGEST_CONCURRENCY=2

# ---- Rendering -----------------------------------------------------------
RENDER_CONCURRENCY=4
RENDER_RETRIES=2
RENDER_TIMEOUT_MS=30000
# MathJax and the fonts are pinned files, fetched once with: python -m mathbot install-render-assets
# RENDER_ASSETS_DIR=data/render_assets

# Hosts whose robots.txt you choose to ignore (comma-separated). Never affects anti-bot challenges.
# AoPS statements are rendered with AoPS's own formula and Asymptote diagram PNGs, like the pre-2.0
# bot. They live on latex.artofproblemsolving.com, whose robots.txt is "Disallow: /", so they are only
# downloaded if you list that host here. Your decision; see README "AoPS images". Without it, AoPS
# problems are not rendered (the bot shows their text); CEMC problems are unaffected.
ROBOTS_OVERRIDE_HOSTS=
# Seconds between statement-image downloads, separate from HTTP_MIN_INTERVAL (page scraping).
# 1.0 takes about 5 hours for every AoPS image; 0.25 about 1.3 hours. Lowering it is your call.
ASSET_MIN_INTERVAL=1.0

# Bot host: install the newest published database at startup (see README, publish-db).
# DATABASE_SNAPSHOT_URL=https://<your public bucket URL>/db/latest.json

# ---- Image storage -------------------------------------------------------
# local: images are served from RENDERS_DIR on this machine.
# s3:    any S3-compatible store. For Cloudflare R2 set the endpoint to
#        https://<account-id>.r2.cloudflarestorage.com
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
# Public URL the bot downloads images from (e.g. your R2 public bucket URL, no trailing slash).
IMAGE_BASE_URL=
# Also try the pre-2.0 object names (<year>_<contest>_<n>.png) in that bucket.
IMAGE_LEGACY_KEYS=true

LOG_LEVEL=INFO
